index 460c695..459065d 100644
--- a/scripts/remaining_libero.py
+++ b/scripts/remaining_libero.py
@@ -46,7 +46,11 @@ def launch_configuration(command: str, arguments: list[str], *, root: Path = ROO
         python = root / python
     if not config.is_absolute():
         config = root / config
-    python, config = python.resolve(), config.resolve()
+    # Do not call Path.resolve() on a venv interpreter. On POSIX, venv/bin/python
+    # is normally a symlink to the base executable; resolving it bypasses the
+    # venv's site-packages and makes an installed LIBERO runtime disappear.
+    python = Path(os.path.abspath(python))
+    config = config.resolve()
     if not python.is_file():
         raise ValueError(f"runtime interpreter is missing: {python}")
     if not (config / "config.yaml").is_file():
