+def test_launcher_preserves_venv_python_symlink(tmp_path):
+    directory = tmp_path / ".runtime" / "remaining_libero"
+    directory.mkdir(parents=True)
+    base = directory / "base-python"
+    base.write_bytes(b"placeholder")
+    venv = directory / "venv" / "bin"
+    venv.mkdir(parents=True)
+    python = venv / "python"
+    python.symlink_to(base)
+    config = directory / "libero_config"
+    config.mkdir()
+    (config / "config.yaml").write_text("{}", encoding="utf-8")
+    (directory / "runtime.json").write_text(json.dumps({
+        "python": str(python), "libero_config_path": str(config), "mujoco_gl": "egl",
+    }), encoding="utf-8")
+
+    command, _ = launcher.launch_configuration("doctor", [], root=tmp_path, platform_name="linux")
+    assert command[0] == str(python)
+    assert command[0] != str(base)
+
+
